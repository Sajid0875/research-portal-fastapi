  "item": [
    {
      "name": "1. Create Research Opportunity #1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains created opportunity with ID\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData.title).to.eql(\"Autonomous Drone Swarm Coordination in GPS-Denied Tunnels\");",
              "    pm.expect(jsonData.status).to.eql(\"Open\");",
              "    pm.collectionVariables.set(\"opportunity_id\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Autonomous Drone Swarm Coordination in GPS-Denied Tunnels\",\n  \"description\": \"Investigating distributed consensus algorithms and visual-inertial SLAM for autonomous UAV swarms operating in subterranean environments without GPS availability.\",\n  \"research_area\": \"Robotics & Autonomous Systems\",\n  \"faculty_name\": \"Dr. Sarah Chen\",\n  \"department\": \"Computer Science & Engineering\",\n  \"required_skills\": \"ROS2, C++, Python, OpenCV, Linear Algebra\",\n  \"available_positions\": 3,\n  \"application_deadline\": \"2026-11-30\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/opportunities",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        },
        "description": "Demonstrates creating research opportunity #1. Saves generated ID to collection variable {{opportunity_id}}."
      },
      "response": []
    },
